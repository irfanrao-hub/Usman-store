# Explicit opt-in. Never silently enables mock services.
DEMO_MODE=true
SITE_URL=http://127.0.0.1:3100
CANONICAL_SITE_URL=https://knitandkin.com
DATABASE_PATH=./data/forme.sqlite
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Set before the separate seed command; no accounts are created at runtime.
SEED_ADMIN_EMAIL=knitandkin1@gmail.com
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# Transactional order email. Keep outbox mode for automated tests.
# For Gmail: enable 2-Step Verification and create a Google App Password.
# Put the password only in .env.local or Netlify's secret environment variables.
EMAIL_MODE=outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=knitandkin1@gmail.com
SMTP_PASS=
EMAIL_FROM=knitandkin1@gmail.com
